# Google OAuth 2.0 Web Client ID
# Buat Client ID di Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:8081, http://localhost:4000
# Authorized Redirect URIs: http://localhost:8081/google-auth-callback
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Android Client ID (Opsional untuk testing native di Expo Go / Android)
# Package name: host.exp.exponent (Expo Go) atau com.daff77.betterlife
# SHA-1: 28:77:80:5C:30:D7:9D:C3:FF:11:80:60:5C:A8:10:E1:92:07:BC:FB (Expo Go)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Backend API Base URL
EXPO_PUBLIC_API_URL=http://localhost:4000

