PORT=4000
GOOGLE_CLIENT_IDS=340702974194-mqp84cjopen5b8rh4jaqt06g8o2t1c0g.apps.googleusercontent.com
NODE_ENV=development
# Persistent database URL:
# - Local embedded PostgreSQL on disk (no external daemon needed): pglite://./data/postgres
# - External PostgreSQL 14+ server: postgresql://betterlife:betterlife_secret@localhost:5432/betterlife_db
DATABASE_URL=pglite://./data/postgres
JWT_SECRET=replace_with_random_secret_at_least_32_characters_long
CORS_ORIGIN=http://localhost:8085,http://localhost:8081,http://localhost:8082,http://localhost:3000
ENABLE_PAYMENT_SANDBOX=false
